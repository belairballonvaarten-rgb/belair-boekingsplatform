# Database (Render.com geeft je een "External Database URL" of "Internal Database URL")
DATABASE_URL=postgres://user:password@localhost:5432/belair_boekingen

# Poort waarop de server draait (Render zet zelf PORT, lokaal kies je zelf)
PORT=3000

# Sessie-secret voor het beheerscherm (verzin een lange willekeurige string)
SESSION_SECRET=verander-dit-naar-iets-lang-en-willekeurigs

# Toegelaten origin voor de aanvraagformulier-API-call vanaf belair-fun.be
CORS_ORIGIN=https://belair-fun.be

# Eerste admin-account (wordt bij eerste opstart aangemaakt als er nog geen admin bestaat)
ADMIN_EMAIL=jonas@belair-fun.be
ADMIN_PASSWORD=verander-dit-wachtwoord
